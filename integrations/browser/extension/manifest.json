{
  "manifest_version": 3,
  "name": "Jarvis Browser Bridge",
  "version": "0.2.0",
  "minimum_chrome_version": "105",
  "description": "Local Jarvis browser control bridge",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
