<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Jarvis_UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="JARVIS" FontSize="36" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" Grid.Row="1" FontSize="20" />
        <TextBlock x:Name="PluginText" Grid.Row="2" />
        <TextBlock x:Name="ConfigText" Grid.Row="3" TextWrapping="Wrap" />
        <TextBlock x:Name="DataText" Grid.Row="4" TextWrapping="Wrap" />
    </Grid>
</Page>
