<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Jarvis_UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#080B12" Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#607080" VerticalAlignment="Center" />
                <TextBlock Text="JARVIS" FontSize="18" FontWeight="SemiBold" Foreground="#EAF6FF" CharacterSpacing="180" />
            </StackPanel>
            <TextBlock x:Name="MicText" HorizontalAlignment="Right" FontSize="12" Foreground="#6F8595"
                       Text="MICROPHONE: INITIALIZING" />
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="620">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Width="300" Height="300" HorizontalAlignment="Center">
                <Ellipse Stroke="#17384A" StrokeThickness="1" Margin="8" />
                <Ellipse Stroke="#205874" StrokeThickness="1.5" Margin="28" />
                <Ellipse x:Name="CoreRing" Stroke="#4CC9F0" StrokeThickness="2" Margin="52" Opacity="0.75" />
                <Ellipse Margin="78">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#102637" Offset="0" />
                            <GradientStop Color="#1A7A9F" Offset="0.55" />
                            <GradientStop Color="#D7F7FF" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="CoreGlow" Width="42" Height="42" Fill="#E6FBFF" Opacity="0.95" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,28,0,0" HorizontalAlignment="Center" Spacing="8">
                <TextBlock x:Name="StatusText" Text="URUCHAMIANIE" HorizontalAlignment="Center"
                           FontSize="28" FontWeight="SemiBold" Foreground="#EAFBFF" CharacterSpacing="120" />
                <TextBlock x:Name="DetailText" Text="Łączenie z modułem głosowym"
                           HorizontalAlignment="Center" FontSize="14" Foreground="#7D96A8" />
            </StackPanel>
            <Border Grid.Row="2" Margin="0,34,0,0" Padding="22" CornerRadius="14"
                    Background="#0D131D" BorderBrush="#172534" BorderThickness="1">
                <StackPanel Spacing="12" MinWidth="620">
                    <TextBlock Text="OSTATNIA INTERAKCJA" FontSize="11" Foreground="#526878" CharacterSpacing="120" />
                    <TextBlock x:Name="TranscriptText" Text="—" FontSize="16" Foreground="#CFE6F3" TextWrapping="Wrap" />
                    <TextBlock x:Name="ResponseText" Text="" FontSize="14" Foreground="#7DBAD2" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,24,0,0">
            <TextBlock Text="VOICE CORE / LOCAL FAST PATH" FontSize="10" Foreground="#394B59" CharacterSpacing="100" />
            <TextBlock HorizontalAlignment="Right" Text="NOR-TEC • MARCIN" FontSize="10"
                       Foreground="#394B59" CharacterSpacing="100" />
        </Grid>
    </Grid>
</Page>
